{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ag-ko-structure-v1",
  "title": "Korean algebraic-geometry structural unit",
  "type": "object",
  "required": ["id", "kind", "parent", "order", "authority", "target", "language", "state"],
  "properties": {
    "id": {"type": "string"},
    "kind": {"enum": ["frontmatter", "legal", "chapter", "section", "subsection", "section_state_update", "prose", "enumeration", "environment", "definition", "definition_prose", "theorem", "proposition", "proposition_prose", "lemma", "corollary", "corollary_prose", "remark", "remark_prose", "example", "example_prose", "note", "note_prose", "proof", "proof_prose", "proof_part", "proof_transition", "display", "equation", "diagram", "footnote", "original_page_marker", "source_page_note", "bibliography"]},
    "parent": {"type": ["string", "null"]},
    "order": {"type": "integer", "minimum": 1},
    "authority": {
      "type": "object",
      "required": ["path", "sha256", "locator"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "locator": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": ["path", "locator"],
      "properties": {
        "path": {"type": "string"},
        "locator": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "relations": {"type": "array", "items": {"type": "string"}},
    "language": {"const": "ko-KR"},
    "state": {
      "type": "object",
      "required": ["translation", "build", "visual", "publication"],
      "properties": {
        "translation": {"enum": ["complete", "complete_with_logged_source_debt", "complete_with_editorial_inference", "complete_with_logged_source_editorial_inference", "partial", "in_progress", "active", "preserved", "pending", "not_applicable"]},
        "build": {"enum": ["pass", "pending", "not_applicable"]},
        "visual": {"enum": ["pass", "pending", "not_applicable"]},
        "publication": {"enum": ["private_working", "release_ready", "published"]}
      }
    }
  }
}
